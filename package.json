{
  "name": "px-to-units",
  "publisher": "px-to-units",
  "author": {
    "name": "Fabian Henao",
    "email": "fabianfeik474@gmail.com",
    "url": "https://github.com/fab-henao"
  },
  "license": "LICENSE.txt",
  "displayName": "px-to-units",
  "description": "convert pixels to any css size",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:less"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "css",
        "extensions": [
          ".css"
        ]
      },
      {
        "id": "scss",
        "extensions": [
          ".scss"
        ]
      },
      {
        "id": "sass",
        "extensions": [
          ".sass"
        ]
      },
      {
        "id": "less",
        "extensions": [
          ".less"
        ]
      }
    ],
    "configuration": {
      "title": "px-to-units",
      "properties": {
        "pxToUnits.rootFontSize": {
          "type": "number",
          "default": 16
        },
        "pxToUnits.viewportWidth": {
          "type": "number",
          "default": 1920
        },
        "pxToUnits.decimalPlaces": {
          "type": "number",
          "default": 2
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "ts-loader": "^9.5.2",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}